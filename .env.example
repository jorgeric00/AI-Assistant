# Puerto local de la app (solo escucha en 127.0.0.1)
PORT=4321
# Ruta de la base de datos SQLite
DATABASE_PATH=./data/assistant.db
# Ruta de la configuración de opencode de la que se leen los servidores MCP (también se lee el .jsonc)
OPENCODE_CONFIG=~/.config/opencode/opencode.json
# URL del servidor de opencode (si está vacío, la app arranca `opencode serve`)
OPENCODE_URL=
# Webhook de Teams (opcional, pendiente)
TEAMS_WEBHOOK_URL=
# JIRA_URL, JIRA_TOKEN, JIRA_MCP_TOKEN y GITHUB_TOKEN también se ponen desde Ajustes > Conexiones,
# que los guarda en este fichero y los aplica sin reiniciar.
# JIRA (lectura por API REST). URL base, p. ej. https://jira.miempresa.com
JIRA_URL=
# Token personal de JIRA (Server/Data Center: Perfil > Personal Access Tokens; Cloud: token de API)
JIRA_TOKEN=
# Token del MCP de JIRA para opencode: lo hereda al abrirlo desde la app (en opencode.jsonc: "Bearer {env:JIRA_MCP_TOKEN}")
JIRA_MCP_TOKEN=
# Solo JIRA Cloud (*.atlassian.net): tu email. En Server/Data Center déjalo vacío
JIRA_EMAIL=
# Consulta de tareas (por defecto, todas las asignadas a ti)
JIRA_JQL=
# Si JIRA usa un certificado de la empresa que Node no reconoce, define NODE_EXTRA_CA_CERTS
# (ruta al .pem de la CA) como variable de entorno de Windows; en este fichero no tiene efecto.
# Avisos de tus PR: token personal de GitHub de solo lectura (fine-grained con "Pull requests: Read"
# y "Commit statuses / Checks: Read", o classic con "repo"). Si los repos son de una organización con SSO,
# autorízalo en GitHub: Settings > Developer settings > tokens > Configure SSO.
GITHUB_TOKEN=
# Solo GitHub Enterprise: URL de su API GraphQL (por defecto https://api.github.com/graphql)
GITHUB_GRAPHQL_URL=
# Carpeta de trabajo de la app (worktrees/<CLAVE>/ con PLAN.md e HISTORIAL.md de cada tarea)
DEV_ASSISTANT_HOME=~/.dev-assistant
# Carpeta global de skills de opencode (donde Ajustes instala la skill dev-assistant-tarea)
OPENCODE_SKILLS_DIR=~/.config/opencode/skill
