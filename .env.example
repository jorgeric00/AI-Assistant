# Puerto local de la app (solo escucha en 127.0.0.1)
PORT=4321
# Ruta de la base de datos SQLite
DATABASE_PATH=./data/assistant.db
# Ruta de la configuración de opencode de la que se leen los servidores MCP
OPENCODE_CONFIG=~/.config/opencode/opencode.json
# URL del servidor de opencode (si está vacío, la app arranca `opencode serve`)
OPENCODE_URL=
# Webhook de Teams (opcional, pendiente)
TEAMS_WEBHOOK_URL=
# JIRA (lectura por API REST). URL base, p. ej. https://jira.miempresa.com
JIRA_URL=
# Token personal de JIRA (Server/Data Center: Perfil > Personal Access Tokens; Cloud: token de API)
JIRA_TOKEN=
# Solo JIRA Cloud (*.atlassian.net): tu email. En Server/Data Center déjalo vacío
JIRA_EMAIL=
# Consulta de tareas (por defecto, todas las asignadas a ti)
JIRA_JQL=
# Si JIRA usa un certificado de la empresa que Node no reconoce, define NODE_EXTRA_CA_CERTS
# (ruta al .pem de la CA) como variable de entorno de Windows; en este fichero no tiene efecto.
