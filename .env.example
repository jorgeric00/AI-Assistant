# Puerto local de la app (solo escucha en 127.0.0.1)
PORT=4321
# Ruta de la base de datos SQLite
DATABASE_PATH=./data/assistant.db
# Ruta de la configuración de opencode de la que se leen los servidores MCP
OPENCODE_CONFIG=~/.config/opencode/opencode.json
# URL del servidor de opencode (si está vacío, la app arranca `opencode serve`)
OPENCODE_URL=
# Webhook de Teams (opcional, pendiente)
TEAMS_WEBHOOK_URL=
